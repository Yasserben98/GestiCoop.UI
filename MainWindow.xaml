<Window x:Class="GestiCoop.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GestiCoop.UI"
        Title="GestiCoop - Gestion des stages coopératifs" Height="680" Width="1050"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <local:EtudiantsViewModel />
    </Window.DataContext>

    <DockPanel Background="#F5F6F8">
        <!-- 1. Barre latérale gauche (Sidebar) -->
        <Border DockPanel.Dock="Left" Width="230" Background="#1F4E79">
            <DockPanel>
                <!-- Profil en bas -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16">
                    <TextBlock Text="K. Aladji" Foreground="White" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="Coordinateur" Foreground="#A9C4E2" FontSize="11"/>
                </StackPanel>

                <!-- Navigation principale -->
                <StackPanel Margin="16,20,16,0">
                    <TextBlock Text="GestiCoop" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Stages coopératifs" Foreground="#A9C4E2" FontSize="11" Margin="0,2,0,24"/>

                    <TextBlock Text="PRINCIPAL" Foreground="#7DA4D3" FontSize="10" FontWeight="Bold" Margin="4,0,0,8"/>

                    <Button Content="📊 Tableau de bord" Background="Transparent" Foreground="#D0E1F9" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,7"/>
                    <Button Content="📄 Offres de stage" Background="Transparent" Foreground="#D0E1F9" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,7"/>

                    <!-- Bouton Étudiants actif -->
                    <Border Background="#2B6CB0" CornerRadius="4" Margin="0,2">
                        <Button Content="👥 Étudiants" Background="Transparent" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,7"/>
                    </Border>

                    <Button Content="📝 Candidatures" Background="Transparent" Foreground="#D0E1F9" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,7"/>
                    <Button Content="🏢 Entreprises" Background="Transparent" Foreground="#D0E1F9" BorderThickness="0" HorizontalContentAlignment="Left" Padding="8,7"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Barre d'état en bas -->
        <StatusBar DockPanel.Dock="Bottom" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,4">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#38A169" Margin="0,0,6,0"/>
                    <TextBlock Text="Connecté : K. Aladji" FontSize="11" Foreground="#4A5568"/>
                    <TextBlock Text=" • 10 étudiants chargés" FontSize="11" Foreground="#718096" Margin="10,0,0,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- 3. Zone principale de contenu -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- En-tête avec titre et bouton rouge -->
                <RowDefinition Height="Auto"/>
                <!-- Barre de filtres -->
                <RowDefinition Height="*"/>
                <!-- Tableau ListView -->
            </Grid.RowDefinitions>

            <!-- Ligne 0 : Titre + Bouton Ajouter -->
            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" 
                        Content="+ Ajouter un étudiant" 
                        Command="{Binding AjouterCommand}"
                        Background="#E53E3E" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Padding="14,8" 
                        BorderThickness="0" 
                        Cursor="Hand"/>
                <TextBlock Text="Liste des étudiants" FontSize="22" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Ligne 1 : Zone de recherche et Filtre ComboBox -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                         Text="{Binding RechercheTexte, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,12,0" 
                         Padding="10,7" 
                         FontSize="12" 
                         VerticalContentAlignment="Center" 
                         BorderBrush="#CBD5E0"/>

                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding Programmes}" 
                          SelectedItem="{Binding ProgrammeFiltre, Mode=TwoWay}" 
                          Padding="8,6" 
                          VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Ligne 2 : ListView avec GridView -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                <ListView ItemsSource="{Binding Etudiants}" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="NOM" DisplayMemberBinding="{Binding Nom}" Width="130"/>
                            <GridViewColumn Header="PRÉNOM" DisplayMemberBinding="{Binding Prenom}" Width="130"/>

                            <!-- Colonne Programme avec Badge Coloré -->
                            <GridViewColumn Header="PROGRAMME" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="8,3" Background="#EBF8FF" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Programme}" FontSize="11" Foreground="#2B6CB0" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <GridViewColumn Header="COURRIEL" DisplayMemberBinding="{Binding Courriel}" Width="240"/>

                            <!-- Colonne Actions : Modifier / Supprimer -->
                            <GridViewColumn Header="ACTIONS" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Modifier" Foreground="#2B6CB0" Cursor="Hand" TextDecorations="Underline" Margin="0,0,6,0"/>
                                            <TextBlock Text="·" Foreground="#A0AEC0" Margin="0,0,6,0"/>
                                            <TextBlock Text="Supprimer" Foreground="#E53E3E" Cursor="Hand" TextDecorations="Underline"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>
    </DockPanel>
</Window>