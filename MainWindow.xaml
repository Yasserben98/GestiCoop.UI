<Window x:Class="GestiCoop.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestiCoop" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Définition des 4 rangées -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Rangée 0 : En-tête -->
            <RowDefinition Height="Auto"/>
            <!-- Rangée 1 : Navigation -->
            <RowDefinition Height="*"/>
            <!-- Rangée 2 : Contenu dynamique -->
            <RowDefinition Height="Auto"/>
            <!-- Rangée 3 : Barre d'état -->
        </Grid.RowDefinitions>

        <!-- Rangée 0 : En-tête -->
        <StackPanel Grid.Row="0" Background="#1F4E79" Orientation="Horizontal">
            <TextBlock Text="GestiCoop" Foreground="White" FontSize="22" FontWeight="Bold" Margin="12"/>
        </StackPanel>

        <!-- Rangée 1 : Navigation (3 boutons fictifs) -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#F0F0F0">
            <Button Content="Tableau de bord" Margin="10,6" Padding="12,6"/>
            <Button Content="Offres de stage" Margin="0,6,10,6" Padding="12,6"/>
            <Button Content="Étudiants" Margin="0,6,10,6" Padding="12,6"/>
        </StackPanel>

        <!-- Rangée 2 : Zone de contenu principal -->
        <Border Grid.Row="2" Background="#FAFAFA" Margin="16" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <TextBlock Text="Bienvenue dans GestiCoop" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="20" 
                       Foreground="#555555"/>
        </Border>

        <!-- Rangée 3 : Barre d'état -->
        <StatusBar Grid.Row="3" Background="#E6E6E6">
            <StatusBarItem>
                <TextBlock Text="Prêt - Session Automne 2026" FontSize="12" Foreground="#333333"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>